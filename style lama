}

/* ===================================================
   8. BUTTON
=================================================== */

.btn {
  
  display: inline-block;
  
  padding: 14px 30px;
  
  background: var(--red);
  
  color: white;
  
  text-decoration: none;
  
  border-radius: 50px;
  
  font-weight: bold;
  
  transition: .3s;
  
}

.btn:hover {
  
  background: var(--brown);
  
}

.btn-outline {
  
  display: inline-block;
  
  padding: 14px 30px;
  
  border: 2px solid var(--red);
  
  color: var(--red);
  
  border-radius: 50px;
  
  text-decoration: none;
  
  font-weight: bold;
  
  transition: .3s;
  
}

.btn-outline:hover {
  
  background: var(--red);
  
  color: white;
  
}

/* ===================================================
   9. TENTANG
=================================================== */

.tentang {
  
