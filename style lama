  margin: auto;
  
  text-align: center;
  
  background: #fff;
  
  padding: 35px;
  
  border-radius: 20px;
  
  box-shadow: 0 10px 25px rgba(0, 0, 0, .08);
  
}

.pembina-card img {
  
  width: 180px;
  
  height: 180px;
  
  object-fit: cover;
  
  border-radius: 50%;
  
  margin-bottom: 20px;
  
  border: 6px solid #b71c1c;
  
}

.pembina-card span {
  
  color: #ff9800;
  
  font-weight: bold;
  
}

.pembina-container {
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
}

.pembina-card {
  width: 300px;
}

.pembina h2 {
  color: #b71c1c;
  font-size: 36px;
  font-weight: 700;
  text-align: center;
  margin-bottom: 40px;
}

body.dark-mode .pembina h2 {
  color: #ffb300;
}

/* ====================== */

.gallery-grid img {
  
  width: 100%;
  
  height: 230px;
  
  object-fit: cover;
  
  border-radius: 18px;
  
  transition: .3s;
  
}

.gallery-grid img:hover {
  
  transform: scale(1.05);
  
}

/* ====================== */

body.dark-mode .about-card,
body.dark-mode .pembina-card {
  
  background: #1f1f1f;
  
  color: #fff;
  
}

body.dark-mode .about-section h2 {
  
  color: #ff9800;
  
}

body.dark-mode .section-tag {
  
  background: #333;
  
  color: #ff9800;
  
}

/* ====================== */

@media(max-width:768px) {
  
  .about-hero-content {
    
    flex-direction: column-reverse;
    
  }
  
  .about-text h1 {
    
    font-size: 38px;
    
    text-align: center;
    
  }
  
  .about-text p {
    
    text-align: center;
    
  }
  
  .about-image img {
    
    width: 200px;
    
  }
  
}

/* Saat card dipilih */

.about-card.active i,
.kegiatan-card.active i,
.manfaat-card.active i {
  
  background: #ffc107;
  color: white !important;
  
}

/* Dark mode */

body.dark-mode .about-card.active i,
body.dark-mode .kegiatan-card.active i,
body.dark-mode .manfaat-card.active i {
  
  background: #ffc107;
  color: #222;
  
}

body:not(.dark-mode) .about-card.active i,
body:not(.dark-mode) .kegiatan-card.active i,
body:not(.dark-mode) .manfaat-card.active i {
  background: #ffc107;
  color: #222;
}

/* Jarak tombol Lihat Semua */

.kegiatan .btn {
  margin-top: 30px;
}

/* ==========================
   PAKSA WARNA MENU TERANG
========================== */

header .menu a {
  color: #ffffff !important;
}

header .logo h2 {
  color: #ffffff !important;
}

header .menu a:hover {
  color: #ffd54f !important;
}

/* ===========================
   MENU ACTIVE
=========================== */

.menu a {
  position: relative;
  color: #fff;
  text-decoration: none;
  transition: .3s;
}

.menu a.active {
  color: #fff;
}

.menu a.active::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -8px;
  width: 100%;
  height: 3px;
  background: #ffb300;
  border-radius: 10px;
}

.menu a:hover::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -8px;
  width: 100%;
  height: 3px;
  background: #ffb300;
  border-radius: 10px;
}

/* ==========================
   CREATED BY
========================== */

.creator {
  margin-top: 20px;
  padding-bottom: 15px;
  text-align: center;
  font-size: 13px;
  color: #d6d6d6;
  letter-spacing: 0.5px;
}

.creator span {
  color: #ffcc33;
  font-weight: 600;
}

/*dark mode button vektor*/
#darkModeBtn i {
  font-size: 20px;
  transition: .4s;
}

#darkModeBtn:hover i {
  transform: rotate(180deg);
}
