/* ===========================
   LOADING SCREEN
=========================== */

#loading-screen{
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--bg-color);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    transition: opacity .8s ease, visibility .8s ease;
}

.loader-content{
    text-align: center;
}

.loader-logo{
    width: 100px;
    margin-bottom: 20px;
}

.loader-content h2{
    color: var(--brown);
    margin-bottom: 10px;
}

.loader-content p{
    color: #666;
    margin-bottom: 20px;
}

.spinner{
    width: 50px;
    height: 50px;
    margin: auto;
    border: 5px solid #ddd;
    border-top: 5px solid #c62828;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin{
    0%{
        transform: rotate(0deg);
    }
    100%{
        transform: rotate(360deg);
    }
}

#loading-screen.hide{
    opacity: 0;
    visibility: hidden;
}
.progress-bar {
  width: 260px;
  height: 8px;
  background: #ddd;
  border-radius: 20px;
  overflow: hidden;
  margin: 20px auto 0;
}

.progress {
  width: 0%;
  height: 100%;
  background: linear-gradient(90deg, #c62828, #ff9800);
  animation: loading 3s forwards;
}

@keyframes loading {
  
  0% {
    width: 0%;
  }
  
  100% {
    width: 100%;
  }
  
}

.loader-logo {
  width: 100px;
  margin-bottom: 20px;
  animation: logoPop 1s ease;
}

@keyframes logoPop {
  
  0% {
    transform: scale(.5);
    opacity: 0;
  }
  
  100% {
    transform: scale(1);
    opacity: 1;
  }
  
}
#loading-screen{
    background: linear-gradient(
        135deg,
        #F7F1E3,
        #EFE4D2,
        #FFFFFF
    );
}

#loading-percent{
    display:block;
    margin-top:15px;
    font-size:18px;
    font-weight:bold;
    color:#c62828;
}

.loader-logo{
    width:110px;
    animation: logoAnimation 1.5s ease;
}

@keyframes logoAnimation{

    0%{
        opacity:0;
        transform:scale(.4) rotate(-15deg);
    }

    60%{
        transform:scale(1.15) rotate(8deg);
    }

    100%{
        opacity:1;
        transform:scale(1) rotate(0deg);
    }

}

