}

.tentang h2 {
  
  text-align: center;
  
  font-size: 36px;
  
  color: var(--text-color);
  
  margin-bottom: 25px;
  
}

.tentang p {
  
  max-width: 850px;
  
  margin: auto;
  
  text-align: center;
  
  line-height: 1.9;
  
  font-size: 18px;
  
}

.tentang .btn {
  
  display: block;
  
  width: 220px;
  
  margin: 40px auto 0;
  
  text-align: center;
  
}

/* ===================================================
   10. KEGIATAN
=================================================== */

.kegiatan {
  padding: 80px 0;
  background: var(--section-color);
}

.kegiatan h2 {
  text-align: center;
  font-size: 36px;
  color: var(--text-color);
  margin-bottom: 50px;
}

.card-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 25px;
}

.card {
  background: var(--card-color);
  border-radius: 18px;
  padding: 30px 25px;
  text-align: center;
  box-shadow: 0 8px 20px rgba(0, 0, 0, .08);
  transition: .3s;
}

.card:hover {
  transform: translateY(-8px);
}

.card h3 {
  color: var(--text-color);
  margin-bottom: 15px;
}

.card p {
  color: #666;
  line-height: 1.7;
}

/* ===================================================
   11. MANFAAT
=================================================== */

.manfaat {
  padding: 80px 0;
}

.manfaat h2 {
  text-align: center;
  font-size: 36px;
  color: var(--text-color);
  margin-bottom: 50px;
}

.manfaat-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 25px;
}

.manfaat-card {
  background: var(--card-color);
  border-radius: 18px;
  padding: 30px 25px;
  text-align: center;
  box-shadow: 0 8px 20px rgba(0, 0, 0, .08);
  transition: .3s;
}

.manfaat-card:hover {
  transform: translateY(-8px);
}

.manfaat-card h3 {
  color: var(--text-color);
  margin-bottom: 15px;
}

.manfaat-card p {
  color: #666;
  line-height: 1.7;
}

/* ===================================================
   12. GALERI
=================================================== */

.galeri {
  padding: 80px 0;
  background: var(--section-color);
}

.galeri h2 {
  text-align: center;
  font-size: 36px;
  color: var(--text-color);
  margin-bottom: 50px;
}

.galeri-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
}

.galeri-container img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  border-radius: 18px;
  transition: .3s;
  cursor: pointer;
}

.galeri-container img:hover {
  transform: scale(1.05);
}

/* ===================================================
   13. FOOTER
=================================================== */

footer{
    background: linear-gradient(
        135deg,
        #5B0000 0%,
        #7A0C0C 25%,
        #A51C1C 55%,
        #D84040 100%
    );

    color: white;
    padding: 55px 0;
    text-align: center;

    /* Garis atas */
    border-top: 2px solid rgba(255,255,255,0.15);

    /* Bayangan */
    box-shadow: 0 -8px 25px rgba(0,0,0,.25);

    transition: .4s;
}

.footer-container {
  width: 90%;
  max-width: 1200px;
  margin: auto;
}

.footer-container h3 {
  margin-bottom: 10px;
  font-size: 28px;
}

.footer-container p {
  margin: 10px 0;
  color: #f0f0f0;
}

.footer-container a {
  color: var(--gold);
  text-decoration: none;
}

.footer-container a:hover {
  color: white;
}

/* ===================================================
   14. RESPONSIVE
=================================================== */

@media (max-width:768px) {
  
  .navbar {
    flex-direction: column;
    gap: 20px;
  }
  
  .menu {
    flex-direction: column;
    align-items: center;
    gap: 15px;
  }
  
  .hero-content {
    flex-direction: column;
    text-align: center;
  }
  
  .hero-text h1 {
    font-size: 42px;
  }
  
  .hero-button {
    justify-content: center;
  }
  
  .hero-image img {
    max-width: 300px;
  }
  
  .card-container,
  .manfaat-container,
  .galeri-container {
    grid-template-columns: 1fr;
  }
  
}

/* ===================================================
   15. DARK MODE
=================================================== */

body.dark-mode {
  
