/* ===================================================
   1. RESET CSS
=================================================== */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* ===================================================
   2. ROOT (VARIABEL WARNA)
=================================================== */

:root {
  
  /* Warna Utama */
  --cream: #F7F1E3;
  --cream-dark: #EFE4D2;
  --brown: #4A3B2F;
  --gold: #D4AF37;
  --red: #B22222;
  --white: #FFFFFF;
  
  /* Tema Website */
  --bg-color: var(--cream);
  --section-color: var(--cream-dark);
  --card-color: var(--white);
  --text-color: var(--brown);
  --header-color: #E8DCC8;
  --footer-color: #B22222;
  
}

/* ===================================================
   3. BODY
=================================================== */

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  padding: 0;
  
  position: relative;
  overflow-x: hidden;
  
  background: var(--bg-color);
  color: var(--text-color);
  
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
  
  transition: .3s;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -1;
  
  background:
    /* Garis diagonal kiri atas */
    linear-gradient(135deg,
      transparent 0%,
      transparent 28%,
      rgba(183, 28, 28, .07) 28%,
      rgba(183, 28, 28, .07) 29%,
      transparent 29%),
    
    /* Garis diagonal kanan bawah */
    linear-gradient(-45deg,
      transparent 0%,
      transparent 82%,
      rgba(255, 152, 0, .07) 82%,
      rgba(255, 152, 0, .07) 83%,
      transparent 83%),
    
    /* Bulatan blur merah */
    radial-gradient(circle at 12% 15%,
      rgba(183, 28, 28, .10) 0,
      transparent 220px),
    
    /* Bulatan blur oranye */
    radial-gradient(circle at 88% 82%,
      rgba(255, 152, 0, .10) 0,
      transparent 220px);
      
      
}
body::after {
  content: "";
  
  position: fixed;
  
  width: 180px;
  height: 180px;
  
  right: 40px;
  top: 140px;
  
  border: 2px solid rgba(183, 28, 28, .08);
  
  transform: rotate(18deg);
  
  border-radius: 18px;
  
  pointer-events: none;
  
  z-index: -1;
}


/* ===================================================
   4. CONTAINER
=================================================== */

.container {
  width: 90%;
  max-width: 1200px;
  margin: auto;
}

/* ===================================================
   HEADER & NAVBAR BARU
=================================================== */

header{

    position: sticky;
    top: 0;
    z-index: 1000;

    background: linear-gradient(
        90deg,
        #7d0000,
        #b71c1c,
        #d32f2f,
        #b71c1c,
        #7d0000
    );

    border-bottom: 2px solid #ffb300;

    box-shadow: 0 6px 20px rgba(0,0,0,.35);

}

.navbar{

    max-width: 1200px;

    margin: auto;

    padding: 15px 30px;

    display: flex;

    justify-content: space-between;

    align-items: center;

    background: transparent;

}

.logo{

    display: flex;

    align-items: center;

    gap: 12px;

}

.logo img{

    width: 55px;

    height: 55px;

    border-radius: 50%;

}

.logo h2 {
  color: #ffffff;
  font-weight: 700;
}

.menu{

    display: flex;

    list-style: none;

    gap: 35px;

}

.menu li{

    list-style: none;

}

.menu a{
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    transition: .3s;
}


.menu a::after{

    content: "";

    position: absolute;

    left: 0;

    bottom: -6px;

    width: 0;

    height: 2px;

    background: #ffb300;

    transition: .3s;

}

.menu a:hover{

    color: #ffb300;

}

.menu a:hover::after{

    width: 100%;

}

#darkModeBtn{

    width: 45px;

    height: 45px;

    border: none;

    border-radius: 50%;

    background: rgba(255,255,255,.15);

    color: white;

    cursor: pointer;

    transition: .3s;

}

#darkModeBtn:hover{

    background: #ffb300;

    color: #111;

    transform: rotate(180deg);

}
