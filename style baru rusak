   ABOUT CARD
=================================================== */

.about-card{

    background:var(--card-color);

    border-radius:20px;

    padding:30px;

    text-align:center;

    cursor:pointer;

    box-shadow:0 8px 20px rgba(0,0,0,.08);

    transition:.35s;

}

.about-card:hover{

    transform:translateY(-8px);

    box-shadow:0 18px 35px rgba(0,0,0,.15);

}

.about-card i{

    width:85px;

    height:85px;

    margin:0 auto 20px;

    display:flex;

    justify-content:center;

    align-items:center;

    border-radius:50%;

    background:#b71c1c;

    color:#ffffff;

    font-size:34px;

    transition:.35s;

}

.about-card:hover i{

    background:#ff9800;

}

.about-card.active i{

    background:#ffc107;

    color:#222222;

}

.about-card h3{

    color:var(--text-color);

    margin-bottom:15px;

}

.about-card p,
.about-card ul{

    color:#666;

    line-height:1.8;

}

/* ===================================================
   DARK MODE
=================================================== */

body.dark-mode .about-section h2{

    color:#ffb300;

}

body.dark-mode .about-card{

    background:#2b2b2b;

    border:1px solid #3f3f3f;

}

body.dark-mode .about-card h3{

    color:#ffffff;

}

body.dark-mode .about-card p,
body.dark-mode .about-card ul{

    color:#d0d0d0;

}

body.dark-mode .section-tag{

    background:#333;

    color:#ffb300;

}

/* ===================================================
   20. PEMBINA
=================================================== */

.pembina {
  
  padding: 80px 0;
  
}

.pembina h2 {
  
  text-align: center;
  
  font-size: 36px;
  
  color: #b71c1c;
  
  font-weight: 700;
  
  margin-bottom: 45px;
  
}

.pembina-container {
  
  display: flex;
  
  justify-content: center;
  
  gap: 30px;
  
  flex-wrap: wrap;
  
}

/* ==========================
   CARD PEMBINA
========================== */

.pembina-card {
  
  width: 300px;
  
  background: var(--card-color);
  
  border-radius: 20px;
  
  padding: 30px;
  
  text-align: center;
  
  box-shadow: 0 10px 25px rgba(0, 0, 0, .10);
  
  transition: .35s;
  
}

.pembina-card:hover {
  
  transform: translateY(-8px);
  
  box-shadow: 0 18px 35px rgba(0, 0, 0, .18);
  
}

.pembina-card img {
  width: 120px;
  height: 120px;
  
  display: block;
  margin: 0 auto 18px;
  
  object-fit: cover;
  
  border-radius: 50%;
  
  border: 4px solid #b71c1c;
}

.pembina-card:hover img {
  
  transform: scale(1.05);
  
}

.pembina-card h3 {
  
  color: var(--text-color);
  
  margin-bottom: 8px;
  
  font-size: 22px;
  
}

.pembina-card span {
  
  display: block;
  
  color: #ff9800;
  
  font-weight: 700;
  
  margin-bottom: 12px;
  
}

.pembina-card p {
  
  color: #666;
  
  line-height: 1.8;
  
}

/* ===================================================
   GALLERY HALAMAN TENTANG
=================================================== */

.gallery-grid {
  
  display: grid;
  
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  
  gap: 20px;
  
}

.gallery-grid img {
  
  width: 100%;
  
  height: 230px;
  
  object-fit: cover;
  
  border-radius: 18px;
  
  transition: .35s;
  
  cursor: pointer;
  
  box-shadow: 0 8px 20px rgba(0, 0, 0, .10);
  
}

.gallery-grid img:hover {
  
  transform: scale(1.05);
  
  box-shadow: 0 18px 35px rgba(0, 0, 0, .18);
  
}

/* ===================================================
   DARK MODE
=================================================== */

body.dark-mode .pembina h2 {
  
  color: #ffb300;
  
}

body.dark-mode .pembina-card {
  
  background: #2b2b2b;
  
  border: 1px solid #3f3f3f;
  
}

body.dark-mode .pembina-card h3 {
  
  color: #ffffff;
  
}

body.dark-mode .pembina-card p {
  
  color: #d0d0d0;
  
}

body.dark-mode .pembina-card span {
  
  color: #ffb300;
  
}

/* ===================================================
   RESPONSIVE
=================================================== */

@media(max-width:768px) {
  
  .pembina-container {
    
    flex-direction: column;
    
    align-items: center;
    
  }
  
  .pembina-card {
    
    width: 100%;
    
    max-width: 320px;
    
  }
  
}

/* ===================================================
   21. LOADING SCREEN
=================================================== */

#loading-screen{
    position: fixed;
    inset: 0;

    display: flex;
    justify-content: center;
    align-items: center;

    background: linear-gradient(
        135deg,
        #F7F1E3,
        #EFE4D2,
        #FFFFFF
    );

    z-index: 99999;
}

#loading-screen.hide{

    opacity:0;
    visibility:hidden;

}

/* ==========================
   CONTENT
========================== */

.loader-content{

    text-align:center;

}

.loader-logo{

    width:110px;

    margin-bottom:20px;

    animation:logoAnimation 1.5s ease;

}

.loader-content h2{

    font-size:30px;

    color:#4A3B2F;

    margin-bottom:10px;

}

.loader-content p{

    color:#666;

    margin-bottom:18px;

}

/* ==========================
   PROGRESS BAR
========================== */

.progress-bar{

    width:260px;

    height:8px;

    background:#dddddd;

    border-radius:30px;

    overflow:hidden;

    margin:18px auto;

}

.progress{

    width:0%;

    height:100%;

    background:linear-gradient(
        90deg,
        #c62828,
        #ff9800
    );

    animation:loadingBar 3s forwards;

}

#loading-percent{

    display:block;

    font-size:18px;

    font-weight:bold;

    color:#c62828;

}

/* ==========================
   ANIMATION
========================== */

@keyframes loadingBar{

    from{

        width:0%;

    }

    to{

        width:100%;

    }

}

@keyframes logoAnimation{

    0%{

        opacity:0;

        transform:scale(.4)
                  rotate(-15deg);

    }

    60%{

        transform:scale(1.15)
                  rotate(8deg);

    }

    100%{

        opacity:1;

        transform:scale(1)
                  rotate(0deg);

    }

}

/* ==========================
   DARK MODE
========================== */

body.dark-mode #loading-screen{

    background:linear-gradient(
        135deg,
        #181818,
        #232323,
        #2f2f2f
    );

}

body.dark-mode .loader-content h2{

    color:#ffffff;

}

body.dark-mode .loader-content p{

    color:#d6d6d6;

}

body.dark-mode .progress-bar{

    background:#444444;

}

body.dark-mode #loading-percent{

    color:#ffb300;

}

/* ===================================================
   22. FINAL FIX & RESPONSIVE
=================================================== */

/* ==========================
   MENU GARIS KUNING
========================== */

.menu a {
  position: relative;
  overflow: hidden;
}

.menu a::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -8px;
  
  width: 0;
  height: 3px;
  
  background: #ffb300;
  border-radius: 20px;
  
  transition:
    width .35s ease,
    left .35s ease;
}

.menu a:hover::after,
.menu a.active::after {
  
  width: 100%;
  left: 0;
  
}

/* ==========================
   DARK MODE BUTTON
========================== */

#darkModeBtn {
  
  display: flex;
  justify-content: center;
  align-items: center;
  
}

#darkModeBtn i {
  
  font-size: 20px;
  transition: .4s;
  
}

#darkModeBtn:hover i {
  
  transform: rotate(180deg);
  
}

/* ==========================
   ICON ACTIVE
========================== */

.card.active i,
.about-card.active i,
.manfaat-card.active .benefit-icon i {
  
  color: #222 !important;
  
}

/* Light Mode */

body:not(.dark-mode) .card.active i,
body:not(.dark-mode) .about-card.active i,
body:not(.dark-mode) .manfaat-card.active .benefit-icon i {
  
  color: #222 !important;
  
}

/* Dark Mode */

body.dark-mode .card.active i,
body.dark-mode .about-card.active i,
body.dark-mode .manfaat-card.active .benefit-icon i {
  
  color: #222 !important;
  
}

