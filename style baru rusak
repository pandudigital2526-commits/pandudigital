   DARK MODE FOOTER
=================================================== */

body.dark-mode footer{

    background:linear-gradient(
        135deg,
        #111111,
        #1a1a1a,
        #222222,
        #2d2d2d
    );

    border-top:2px solid #ffb300;

}

body.dark-mode .footer-container p{

    color:#d8d8d8;

}

body.dark-mode .creator{

    color:#bbbbbb;

}

body.dark-mode .creator span{

    color:#ffb300;

}

/* ===================================================
   19. HALAMAN TENTANG
=================================================== */

.about-hero{

    position:relative;

    overflow:hidden;

    padding:110px 10%;

    background:
    radial-gradient(circle at top right,
    rgba(255,193,7,.18),
    transparent 35%),

    linear-gradient(
    135deg,
    #7f1111 0%,
    #a81515 40%,
    #b71c1c 100%
    );

    color:#ffffff;

}

.about-hero::before{

    content:"";

    position:absolute;

    inset:0;

    background:
    repeating-linear-gradient(
    -45deg,
    transparent 0,
    transparent 55px,
    rgba(255,255,255,.04) 55px,
    rgba(255,255,255,.04) 70px
    );

}

.about-hero-content{

    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:60px;

    flex-wrap:wrap;

}

.about-text{

    flex:1;

}

.section-tag{

    display:inline-block;

    background:#ffffff;

    color:#b71c1c;

    padding:8px 18px;

    border-radius:40px;

    font-weight:700;

    margin-bottom:18px;

}

.about-text h1{

    font-size:50px;

    margin-bottom:18px;

}

.about-text p{

    font-size:18px;

    line-height:1.8;

}

.about-image{

    flex:1;

    display:flex;

    justify-content:center;

}

.about-image img{

    width:320px;

    border-radius:50%;

    box-shadow:
    0 15px 35px rgba(0,0,0,.35),
    0 0 35px rgba(255,193,7,.25);

    transition:.35s;

}

.about-image img:hover{

    transform:scale(1.04);

}

/* ===================================================
   ABOUT SECTION
=================================================== */

.about-section{

    padding:80px 0;

}

.about-section h2{

    text-align:center;

    font-size:36px;

    color:#b71c1c;

    margin-bottom:45px;

}

.about-grid,
.tujuan-grid,
.struktur-grid,
.gallery-grid{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

    gap:25px;

}

