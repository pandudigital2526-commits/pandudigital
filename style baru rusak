/* ===================================================
   PANDU DIGITAL STYLE.CSS
   PART 1
   RESET • ROOT • BODY • BACKGROUND • CONTAINER
=================================================== */

/* ===================================================
   1. RESET
=================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

img{
    max-width:100%;
    display:block;
}

a{
    text-decoration:none;
}

ul{
    list-style:none;
}

button{
    font-family:inherit;
}

/* ===================================================
   2. ROOT
=================================================== */

:root{

    --cream:#F7F1E3;
    --cream-dark:#EFE4D2;

    --brown:#4A3B2F;

    --gold:#D4AF37;

    --red:#B22222;

    --white:#FFFFFF;

    --bg-color:var(--cream);

    --section-color:var(--cream-dark);

    --card-color:var(--white);

    --text-color:var(--brown);

    --header-color:#E8DCC8;

    --footer-color:#B22222;

    --transition:.35s;

}

/* ===================================================
   3. BODY
=================================================== */

body{

    font-family:Arial,Helvetica,sans-serif;

    background:var(--bg-color);

    color:var(--text-color);

    line-height:1.6;

    overflow-x:hidden;

    position:relative;

    transition:var(--transition);

}

/* ===================================================
   4. BACKGROUND EFFECT
=================================================== */

body::before{

    content:"";

    position:fixed;

    inset:0;

    z-index:-2;

    pointer-events:none;

    background:

    linear-gradient(
        135deg,
        transparent 0%,
        transparent 28%,
        rgba(183,28,28,.07) 28%,
        rgba(183,28,28,.07) 29%,
        transparent 29%
    ),

    linear-gradient(
        -45deg,
        transparent 0%,
        transparent 82%,
        rgba(255,152,0,.07) 82%,
        rgba(255,152,0,.07) 83%,
        transparent 83%
    ),

    radial-gradient(
        circle at 12% 15%,
        rgba(183,28,28,.10) 0,
        transparent 220px
    ),

    radial-gradient(
        circle at 88% 82%,
        rgba(255,152,0,.10) 0,
        transparent 220px
    );

}

body::after{

    content:"";

    position:fixed;

    width:180px;
    height:180px;

    top:140px;

    right:40px;

    border-radius:18px;

    transform:rotate(18deg);

    border:2px solid rgba(183,28,28,.08);

    pointer-events:none;

    z-index:-2;

}

/* ===================================================
   5. CONTAINER
=================================================== */

.container{

    width:90%;

    max-width:1200px;

    margin:auto;

}

/* ===================================================
   6. GLOBAL TRANSITION
=================================================== */

body,
header,
section,
footer,
.card,
.manfaat-card,
.about-card,
button,
.menu a{

    transition:var(--transition);

}

/* ===================================================
   7. HEADER
=================================================== */

header{

    position:sticky;

    top:0;

    z-index:1000;

    background:linear-gradient(
        90deg,
        #7d0000,
        #b71c1c,
        #d32f2f,
        #b71c1c,
        #7d0000
    );

    border-bottom:2px solid #ffb300;

    box-shadow:0 6px 20px rgba(0,0,0,.35);

}

/* ===================================================
   8. NAVBAR
=================================================== */

.navbar{

    width:90%;

    max-width:1200px;

    margin:auto;

    padding:15px 0;

    display:flex;

    justify-content:space-between;

    align-items:center;

}

/* ===================================================
   9. LOGO
=================================================== */

.logo{

    display:flex;

    align-items:center;

    gap:15px;

}

.logo img{

    width:70px;

    height:70px;

    object-fit:cover;

    border-radius:50%;

}

.logo h2{

    color:#ffffff;

    font-size:28px;

    font-weight:700;

}

/* ===================================================
   10. MENU
=================================================== */

.menu{

    display:flex;

    align-items:center;

    gap:35px;

}

.menu li{

    position:relative;

}

.menu a{

    position:relative;

    color:#ffffff;

    font-size:16px;

    font-weight:600;

    padding:5px 0;

    transition:.3s;

}

/* Garis Kuning */

.menu a::after{

    content:"";

    position:absolute;

    left:50%;

    bottom:-8px;

    width:0;

    height:3px;

    background:#ffb300;

    border-radius:20px;

    transform:translateX(-50%);

    transition:.35s;

}

.menu a:hover{

    color:#ffd54f;

}

.menu a:hover::after{

    width:100%;

}

.menu a.active{

    color:#ffffff;

}

.menu a.active::after{

    width:100%;

}

/* ===================================================
   11. DARK MODE BUTTON
=================================================== */

#darkModeBtn{

    width:45px;

    height:45px;

    border:none;

    border-radius:50%;

    background:rgba(255,255,255,.15);

    color:#ffffff;

    cursor:pointer;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:18px;

    transition:.35s;

}

#darkModeBtn:hover{

    background:#ffb300;

    color:#111111;

    transform:rotate(180deg);

}

#darkModeBtn i{

    transition:.35s;

}

/* ===================================================
   12. HERO
=================================================== */

.hero {
  
  padding: 90px 0 80px;
  
}

.hero-content {
  
  display: flex;
  
  justify-content: space-between;
  
  align-items: center;
  
  gap: 60px;
  
  flex-wrap: wrap;
  
}

.hero-text {
  
  flex: 1;
  
  min-width: 320px;
  
}

.hero-text h4 {
  
  color: var(--gold);
  
  letter-spacing: 3px;
  
  font-size: 18px;
  
  margin-bottom: 12px;
  
  font-weight: 700;
  
}

.hero-text h1 {
  
  font-size: 58px;
  
  line-height: 1.15;
  
  color: var(--text-color);
  
  margin-bottom: 20px;
  
  font-weight: 800;
  
}

.hero-text h1 span {
  
  color: var(--red);
  
}

.hero-text p {
  
  max-width: 560px;
  
  font-size: 18px;
  
  color: var(--text-color);
  
  line-height: 1.9;
  
  margin-bottom: 35px;
  
}

.hero-button {
  
  display: flex;
  
  gap: 18px;
  
  flex-wrap: wrap;
  
  align-items: center;
  
}

.hero-image {
  
  flex: 1;
  
  min-width: 300px;
  
  display: flex;
  
  justify-content: center;
  
  align-items: center;
  
}

.hero-image img {
  
  width: 100%;
  
  max-width: 400px;
  
  border-radius: 50%;
  
  box-shadow:
    0 18px 40px rgba(0, 0, 0, .18),
    0 0 30px rgba(212, 175, 55, .20);
  
  transition: .4s;
  
}

.hero-image img:hover {
  
  transform: translateY(-8px) scale(1.03);
  
}

/* ===================================================
   HERO DARK MODE
=================================================== */

body.dark-mode .hero-text h1 {
  
  color: #ffffff;
  
}

body.dark-mode .hero-text p {
  
  color: #d8d8d8;
  
}

body.dark-mode .hero-image img {
  
  box-shadow:
    0 18px 40px rgba(0, 0, 0, .45),
    0 0 35px rgba(255, 179, 0, .20);
  
}

/* ===================================================
   13. BUTTON
=================================================== */

.btn {
  
  display: inline-block;
  
  padding: 14px 30px;
  
  background: var(--red);
  
  color: #ffffff;
  
  border: none;
  
  border-radius: 50px;
  
  font-weight: 700;
  
  transition: .35s;
  
  cursor: pointer;
  
  box-shadow: 0 8px 18px rgba(178, 34, 34, .25);
  
}

.btn:hover {
  
  background: var(--brown);
  
  transform: translateY(-3px);
  
  box-shadow: 0 15px 25px rgba(0, 0, 0, .20);
  
}

.btn-outline {
  
  display: inline-block;
  
  padding: 14px 30px;
  
  border: 2px solid var(--red);
  
  border-radius: 50px;
  
  background: transparent;
  
  color: var(--red);
  
  font-weight: 700;
  
  transition: .35s;
  
}

.btn-outline:hover {
  
  background: var(--red);
  
  color: #ffffff;
  
  transform: translateY(-3px);
  
}

/* ===================================================
   14. TENTANG
=================================================== */

.tentang {
  
  padding: 85px 0;
  
}

.tentang h2 {
  
  text-align: center;
  
  font-size: 38px;
  
  color: var(--text-color);
  
  margin-bottom: 25px;
  
}

.tentang p {
  
  max-width: 850px;
  
  margin: auto;
  
  text-align: center;
  
  font-size: 18px;
  
  line-height: 1.9;
  
  color: var(--text-color);
  
}

.tentang .btn {
  
  display: block;
  
  width: 220px;
  
  margin: 45px auto 0;
  
  text-align: center;
  
}

/* ===================================================
   PERBAIKAN BUTTON KEGIATAN
=================================================== */

.kegiatan .btn {
  
  display: block;
  
  width: 200px;
  
  margin: 40px auto 0;
  
  text-align: center;
  
}

/* ===================================================
   DARK MODE BUTTON
=================================================== */

body.dark-mode .btn {
  
  background: #B22222;
  
  color: #ffffff;
  
}

body.dark-mode .btn:hover {
  
  background: #D84040;
  
}

body.dark-mode .btn-outline {
  
  border-color: #ffb300;
  
  color: #ffb300;
  
}

body.dark-mode .btn-outline:hover {
  
  background: #ffb300;
  
  color: #111111;
  
}

/* ===================================================
   15. KEGIATAN
=================================================== */

.kegiatan {
  padding: 80px 0;
  background: var(--section-color);
}

.kegiatan h2 {
  text-align: center;
  font-size: 36px;
  color: var(--text-color);
  margin-bottom: 50px;
}

/* ==========================
   CARD CONTAINER
========================== */

.card-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 25px;
}

/* ==========================
   CARD
========================== */

.card {
  background: var(--card-color);
  border-radius: 18px;
  padding: 30px 25px;
  text-align: center;
  cursor: pointer;
  box-shadow: 0 8px 20px rgba(0, 0, 0, .08);
  transition: .35s;
}

.card:hover {
  transform: translateY(-8px);
  box-shadow: 0 15px 30px rgba(0, 0, 0, .15);
}

/* ==========================
   ICON
========================== */

.card i {
  
  width: 85px;
  height: 85px;
  
  margin: 0 auto 22px;
  
  display: flex;
  justify-content: center;
  align-items: center;
  
  border-radius: 50%;
  
  background: #b71c1c;
  color: #ffffff;
  
  font-size: 34px;
  
  transition: .35s;
  
}

/* Hover */

.card:hover i {
  
  background: #ff9800;
  
  color: #ffffff;
  
  transform: scale(1.1);
  
}

/* Saat Card Dipilih */

.card.active i {
  
  background: #ffc107;
  
  color: #222222;
  
}

/* ==========================
   TEXT
========================== */

.card h3 {
  
  color: var(--text-color);
  
  margin-bottom: 15px;
  
  font-size: 22px;
  
}

.card p {
  
  color: #666;
  
  line-height: 1.7;
  
}

/* Tombol */

.kegiatan .btn {
  
  display: block;
  
  width: 200px;
  
  margin: 35px auto 0;
  
  text-align: center;
  
}

/* ==========================
   DARK MODE
========================== */

body.dark-mode .card {
  
  background: #2b2b2b;
  
  border: 1px solid #3f3f3f;
  
  box-shadow: 0 10px 25px rgba(0, 0, 0, .35);
  
}

body.dark-mode .card h3 {
  
  color: #ffffff;
  
}

body.dark-mode .card p {
  
  color: #d0d0d0;
  
}

/* Hover Dark */

body.dark-mode .card:hover i {
  
  background: #ff9800;
  
  color: #ffffff;
  
}

/* Active Dark */

body.dark-mode .card.active i {
  
  background: #ffc107;
  
  color: #222222;
  
}

/* ===================================================
   16. MANFAAT
=================================================== */

.manfaat {
  padding: 80px 0;
}

.manfaat h2 {
  text-align: center;
  font-size: 36px;
  color: var(--text-color);
  margin-bottom: 50px;
}

/* ==========================
   CONTAINER
========================== */

.manfaat-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 25px;
}

/* ==========================
   CARD
========================== */

.manfaat-card {
  
  background: var(--card-color);
  
  border-radius: 18px;
  
  padding: 30px 25px;
  
  text-align: center;
  
  cursor: pointer;
  
  box-shadow: 0 8px 20px rgba(0, 0, 0, .08);
  
  transition: .35s;
  
}

.manfaat-card:hover {
  
  transform: translateY(-8px);
  
  box-shadow: 0 15px 30px rgba(0, 0, 0, .15);
  
}

/* ==========================
   ICON
========================== */

.benefit-icon {
  
  width: 85px;
  
  height: 85px;
  
  margin: 0 auto 22px;
  
  display: flex;
  
  justify-content: center;
  
  align-items: center;
  
  border-radius: 50%;
  
  background: #b71c1c;
  
  transition: .35s;
  
}

.benefit-icon i {
  
  font-size: 34px;
  
  color: #ffffff;
  
  transition: .35s;
  
}

/* Hover */

.manfaat-card:hover .benefit-icon {
  
  background: #ff9800;
  
  transform: scale(1.1);
  
}

.manfaat-card:hover .benefit-icon i {
  
  color: #ffffff;
  
}

/* Active */

.manfaat-card.active .benefit-icon {
  
  background: #ffc107;
  
}

.manfaat-card.active .benefit-icon i {
  
  color: #222222;
  
}

/* ==========================
   TEXT
========================== */

.manfaat-card h3 {
  
  color: var(--text-color);
  
  margin-bottom: 15px;
  
  font-size: 22px;
  
}

.manfaat-card p {
  
  color: #666;
  
  line-height: 1.7;
  
}

/* ==========================
   DARK MODE
========================== */

body.dark-mode .manfaat-card {
  
  background: #2b2b2b;
  
  border: 1px solid #3f3f3f;
  
  box-shadow: 0 10px 25px rgba(0, 0, 0, .35);
  
}

body.dark-mode .manfaat-card h3 {
  
  color: #ffffff;
  
}

body.dark-mode .manfaat-card p {
  
  color: #d0d0d0;
  
}

body.dark-mode .manfaat-card.active .benefit-icon {
  
  background: #ffc107;
  
}

body.dark-mode .manfaat-card.active .benefit-icon i {
  
  color: #222222;
  
}

/* ===================================================
   17. GALERI
=================================================== */

.galeri {
  
  padding: 80px 0;
  
  background: var(--section-color);
  
}

.galeri h2 {
  
  text-align: center;
  
  font-size: 36px;
  
  color: var(--text-color);
  
  margin-bottom: 50px;
  
}

/* ==========================
   GALERI CONTAINER
========================== */

.galeri-container {
  
  display: grid;
  
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  
  gap: 20px;
  
}

/* ==========================
   FOTO
========================== */

.galeri-container img {
  
  width: 100%;
  
  height: 220px;
  
  object-fit: cover;
  
  border-radius: 18px;
  
  cursor: pointer;
  
  transition: .35s;
  
  box-shadow: 0 8px 20px rgba(0, 0, 0, .10);
  
}

.galeri-container img:hover {
  
  transform: scale(1.05);
  
  box-shadow: 0 18px 35px rgba(0, 0, 0, .18);
  
}

/* ==========================
   DARK MODE
========================== */

body.dark-mode .galeri {
  
  background: #242424;
  
}

body.dark-mode .galeri-container img {
  
  box-shadow: 0 10px 25px rgba(0, 0, 0, .35);
  
}

/* ===================================================
   18. FOOTER
=================================================== */

footer{

    background:linear-gradient(
        135deg,
        #5B0000 0%,
        #7A0C0C 25%,
        #A51C1C 55%,
        #D84040 100%
    );

    color:#ffffff;

    padding:55px 0 30px;

    text-align:center;

    border-top:2px solid rgba(255,255,255,.15);

    box-shadow:0 -8px 25px rgba(0,0,0,.25);

    transition:.35s;

}

.footer-container{

    width:90%;

    max-width:1200px;

    margin:auto;

}

.footer-container h3{

    font-size:30px;

    margin-bottom:12px;

    font-weight:700;

}

.footer-container p{

    margin:8px 0;

    color:#f2f2f2;

    line-height:1.8;

}

.footer-container a{

    color:#ffd54f;

    text-decoration:none;

    transition:.3s;

}

.footer-container a:hover{

    color:#ffffff;

}

/* ===================================================
   CREATED BY
=================================================== */

.creator{

    margin-top:22px;

    padding-top:15px;

    border-top:1px solid rgba(255,255,255,.15);

    font-size:13px;

    color:#dddddd;

    letter-spacing:.5px;

}

.creator span{

    color:#ffd54f;

    font-weight:700;

    transition:.3s;

}

.creator span:hover{

    color:#ffffff;

}

